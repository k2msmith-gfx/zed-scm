ctor-set!|vector\\?|with-exception-handler|with-input-from-file|with-output-to-file|with-output-to-string|with-seed|write|write-bytevector|write-char|write-shared|write-simple|write-string|write-u8|zero\\?)$"))
;; --- END generated ---

;; --- quoted data ------------------------------------------------------------

;; Quoted material is data, not code, down the first four levels -- the same
;; depth-limited trick the upstream queries use, since a query cannot recurse.
(quote _ @constant)
(quote (_ _* @constant))
(quote (_ (_ _* @constant)))
(quote (_ (_ (_ _* @constant))))

;; --- comments ---------------------------------------------------------------

[(comment) (block_comment) (sexp_comment) (directive)] @comment
