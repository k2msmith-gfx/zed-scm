;; Syntax highlighting for scm (https://github.com/k2msmith-gfx/zed-scm).
;;
;; Node names are 6cdh/tree-sitter-scheme >= 0.25.0; `syntax_quote` and
;; `sexp_comment` do not exist before it. Patterns are ordered general to
;; specific, because a later pattern wins: `(symbol) @variable` has to come
;; before the patterns that pick particular symbols out of head position.
;;
;; Three of scm's own spellings need care, and none of them has a node of
;; its own -- `:` and `&` are legal identifier initials, so the reader hands
;; back plain symbols and the spelling has to be recognised by text:
;;
;;   :at          a keyword, disjoint from symbols in scm (subset.md, "The
;;                deviations" 3). `#:at` reads as the same datum and does
;;                have a node, `keyword`.
;;   &opt         a lambda-list marker (subset.md, "The additions" 1).
;;   [a b c]      a vector constructor, not a list (subset.md 3), though the
;;                grammar parses it as `list`. The brackets are coloured
;;                apart from parens to keep that visible.

;; --- atoms -----------------------------------------------------------------

(number) @number
(boolean) @constant
(character) @constant
(string) @string
(escape_sequence) @string.escape
(datum_label) @label
(datum_label_id) @label
(datum_reference) @label

(symbol) @variable

;; --- punctuation -----------------------------------------------------------

["(" ")"] @punctuation.bracket
;; A bracket vector is a different datum from a list; colour it that way.
["[" "]"] @punctuation.special
(dot) @punctuation.delimiter

[(quote) (quasiquote) (syntax_quote) (quasisyntax)] @punctuation.special
[(unquote) (unquote_splicing) (unsyntax) (unsyntax_splicing)] @punctuation.special

;; --- keywords, scm's two spellings -----------------------------------------

(keyword) @string.special.symbol
((symbol) @string.special.symbol
 (#match? @string.special.symbol "^:"))

;; --- the lambda list -------------------------------------------------------

((symbol) @keyword
 (#match? @keyword "^&(opt|named|keys)$"))

;; --- head position ---------------------------------------------------------

;; Anything in head position is being called.
(list . (symbol) @function)

;; Special forms the VM knows itself (scm/src/vm.rs, `SpecialForms`), and the
;; macros the prelude defines (scm/src/prelude.scm, `define-syntax`). `each`,
;; `for`, `repeat` and `seq` are scm's, not R7RS's. There is no `λ`: scm does
;; not read it.
(list
  .
  (symbol) @keyword
  (#any-of? @keyword
   "and" "assert" "begin" "case" "case-lambda" "cond" "cond-expand"
   "define" "define-library" "define-record-type" "define-syntax"
   "define-values" "delay" "delay-force" "do" "each" "for" "guard" "if"
   "import" "lambda" "let" "let*" "let*-values" "let-syntax" "let-values"
   "letrec" "letrec*" "letrec-syntax" "or" "parameterize" "quasiquote"
   "quote" "receive" "repeat" "seq" "set!" "syntax-rules" "unless"
   "unquote" "unquote-splicing" "when"))

;; Auxiliary keywords: these are not calls and are not in head position, so
;; the pattern above cannot reach them.
((symbol) @keyword
 (#any-of? @keyword "else" "=>" "..." "_"))

;; Library declaration keywords, inside `define-library` and `import`.
(list
  .
  (symbol) @keyword
  (#any-of? @keyword
   "export" "include" "include-ci" "include-library-declarations"
   "only" "except" "prefix" "rename" "scheme" "srfi"))

;; --- the name a definition binds -------------------------------------------

(list
  .
  (symbol) @keyword
  (#any-of? @keyword "define" "define-values" "define-record-type" "define-library")
  .
  [(symbol) @variable.special
   (list . (symbol) @function)])

(list
  .
  (symbol) @keyword
  (#eq? @keyword "define-syntax")
  .
  (symbol) @function)

;; --- operators -------------------------------------------------------------

((symbol) @operator
 (#match? @operator "^([-+*/]|[<>]=?|=|<=|>=)$"))

;; --- BEGIN generated by scripts/gen-builtins.sh ---
;; 359 procedures and variables bound by scm 0.0.1 at startup, from
;; (apropos ""). Regenerate rather than edit. A builtin in head position is
;; a call; `@function.builtin` is preferred and falls back to `@function`
;; for themes that do not style it (Zed resolves fallbacks right-to-left).
(list
  .
  (symbol) @function @function.builtin
  (#match? @function.builtin
   "^(\\*|\\+|-|->string|\\/|<|<=|=|>|>=|abs|acos|any-null\\?|append|append2|apply|apply-to-list|apropos|arithmetic-shift|array-dimensions|array-in-bounds\\?|array-rank|array-ref|array\\?|asin|assoc|assq|assv|atan|binary-port\\?|bit-count|bitwise-and|bitwise-ior|bitwise-not|bitwise-xor|boolean=\\?|boolean\\?|bytevector|bytevector-append|bytevector-copy|bytevector-copy!|bytevector-length|bytevector-u8-ref|bytevector-u8-set!|bytevector\\?|caaaar|caaadr|caaar|caadar|caaddr|caadr|caar|cadaar|cadadr|cadar|caddar|cadddr|caddr|cadr|call-with-current-continuation|call-with-input-file|call-with-output-file|call-with-port|call-with-values|call\\/cc|car|cdaaar|cdaadr|cdaar|cdadar|cdaddr|cdadr|cdar|cddaar|cddadr|cddar|cdddar|cddddr|cdddr|cddr|cdr|ceiling|char->integer|char-alphabetic\\?|char-ci<=\\?|char-ci<\\?|char-ci=\\?|char-ci>=\\?|char-ci>\\?|char-downcase|char-foldcase|char-lower-case\\?|char-numeric\\?|char-ready\\?|char-upcase|char-upper-case\\?|char-whitespace\\?|char<=\\?|char<\\?|char=\\?|char>=\\?|char>\\?|char\\?|close-input-port|close-output-port|close-port|command-line|complex\\?|cons|cos|current-error-port|current-input-port|current-jiffy|current-output-port|current-random-source|current-second|dec|delete-file|denominator|digit-value|display|doc|dynamic-wind|emergency-exit|eof-object|eof-object\\?|eq\\?|equal-hash|equal\\?|eqv-hash|eqv\\?|error|error-message|error-object-irritants|error-object-message|error-object\\?|eval|even\\?|exact|exact->inexact|exact-integer-sqrt|exact-integer\\?|exact\\?|exit|exp|expt|features|file-error\\?|file-exists\\?|filter|finite\\?|first-set-bit|floor|floor-quotient|floor-remainder|floor\\/|flush-output-port|fold-left|for-each|force|format|gcd|get-environment-variable|get-environment-variables|get-output-bytevector|get-output-string|inc|inexact|inexact->exact|inexact\\?|infinite\\?|input-port-open\\?|input-port\\?|integer->char|integer-length|integer\\?|interaction-environment|jiffies-per-second|keyword->string|keyword\\?|lcm|lengt